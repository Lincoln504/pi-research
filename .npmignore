# Development infrastructure
# Note: the `files` field in package.json is the primary allowlist.
# This file provides defence-in-depth for anything that leaks through.
.git/
.gitignore
.gitattributes
.github/
.nvmrc
config/
tsconfig*.json
vitest.config*.ts

# docs/ — only SDK.md, ARCHITECTURE.md, OVERVIEW.md, and README-banner.jpg are in the files allowlist.
docs/DEVELOPMENT.md

# Tests
test/
test/stress/
*.test.ts
*.spec.ts

# Test output
coverage/
.nyc_output/
test-results/
playwright-report/
testing-results/
testing/*-results/

# Build artifacts
build/
out/
*.tsbuildinfo

# IDE / editor
.vscode/
.idea/
*.swp
*.swo
*~
.claude/

# Environment
.env
.env.local
.env.*.local
.pi-research.env

# Logs
logs/
*.log
config-debug.log

# Temporary and patch files
*.tmp
.temp/
.tmp/
*.patch
*.diff
COMMIT_MESSAGE*.txt

# Runtime generated files (never publish)
knowledge_db/
state_db/
shared-links-pool-*.json
pi-research-*.md
ts-errors*.log
test-results.txt
integration-test-run.log

# Session / planning artifacts
planchat.txt
*_SUMMARY.md
*_REPORT.md
*_PLAN.md
*_RESULTS.md
*_FIX.md
*_CHECKLIST.md
*_ROADMAP.md
*_ASSESSMENT.md
*_STATUS.md
CIRCULAR_*.md
ZERO_SCOPE_CREEP_REMEDIATION.md
VERIFICATION_REPORT.md

# Browser cache
.browser/

# Playwright
.playwright/
