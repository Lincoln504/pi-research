# Defence-in-depth blocklist for npm pack.
# The `files` field in package.json is the primary allowlist — this file
# catches anything that might accidentally leak through src/ or future additions.

# Never ship config or test infrastructure
config/
tsconfig*.json
vitest.config*.ts
.nvmrc

# Never ship test files (even if they end up under src/)
*.test.ts
*.spec.ts
test/
test/stress/
coverage/
.nyc_output/
test-results/


# Build tooling (defence-in-depth; not in files[])
.github/
.eslint*
prettier*

# IDE and editor
.vscode/
.idea/
*.swp
*.swo
*~
.claude/

# Environment and secrets
.env
.env.local
.env.*.local
.pi-research.env

# Logs, temp, and generated output
logs/
*.log
*.tmp
.temp/
.tmp/
*.patch
*.diff

# Runtime databases
knowledge_db/
state_db/

# Research output (exported reports, pool files)
pi-research-*.md
shared-links-pool-*.json

# Browser and playwright caches
.browser/
.playwright/
playwright-report/
playwright/.cache/

# Build artifacts
build/
out/
*.tsbuildinfo

# OS cruft
Thumbs.db
Desktop.ini
.DS_Store

# Session / planning artifacts (never belong in a release)
planchat.txt
*_SUMMARY.md
*_REPORT.md
*_PLAN.md
*_RESULTS.md
*_FIX.md
*_CHECKLIST.md
*_ROADMAP.md
*_ASSESSMENT.md
*_STATUS.md
CIRCULAR_*.md
ZERO_SCOPE_CREEP_REMEDIATION.md
VERIFICATION_REPORT.md
