# pi-research configuration
#
# pi reads process.env. Use your shell, a pi launcher, direnv, or any other
# env loader — this file is not loaded automatically.
#
# To persist settings, copy the lines you want into ~/.pi/research/config.env
# (the file the /research-config TUI edits), or export them in your shell.

# ── Research ──────────────────────────────────────────────────────────────────

# Per-researcher timeout in milliseconds. (default: 300000, range: 180000–1800000)
# PI_RESEARCH_TIMEOUT_MS=300000

# Maximum researchers running simultaneously. (default: 3, range: 1–5)
# PI_RESEARCH_MAX_RESEARCHERS=3

# Default depth for /research command. (default: 1, range: 1–3)
# 1=normal, 2=deep, 3=ultra.
# PI_RESEARCH_DEFAULT_RESEARCH_DEPTH=1

# Scrape batches per researcher. (default: 2, range: 0–99, 0=unlimited)
# PI_RESEARCH_MAX_SCRAPE_BATCHES=2

# Shared web-gathering calls per researcher (search + security_search + stackexchange +
# youtube_transcript). Local grep has its own separate budget. (default: 12, range: 1–100)
# PI_RESEARCH_MAX_GATHERING_CALLS=12

# Concurrent URLs fetched per scrape batch. (default: 3, range: 1–20)
# PI_RESEARCH_MAX_CONCURRENT_SCRAPES=3

# ── YouTube transcripts ───────────────────────────────────────────────────────
# The youtube_transcript tool reads captions of YouTube videos a researcher
# found in its link pool (one call per researcher, batched).

# Max videos transcribed per youtube_transcript call. (default: 3, range: 1–5)
# PI_RESEARCH_YOUTUBE_TRANSCRIPT_MAX_VIDEOS=3

# Per-video timeout for the youtube_transcript tool, ms. (default: 20000, range: 5000–120000)
# PI_RESEARCH_YOUTUBE_TRANSCRIPT_TIMEOUT_MS=20000

# Preferred caption language (BCP-47 prefix). (default: en)
# PI_RESEARCH_YOUTUBE_TRANSCRIPT_LANG=en

# Append 'youtube' to roughly one-in-N search queries so DuckDuckGo surfaces
# YouTube (which it rarely does otherwise). 1 = every query. (default: 5, range: 1–100)
# PI_RESEARCH_YOUTUBE_QUERY_EVERY_N=5

# Advanced: override the YouTube BotGuard PoToken request key (only if YouTube
# rotates the public web key and transcripts start failing). (default: built-in)
# PI_RESEARCH_YOUTUBE_POTOKEN_REQUEST_KEY=

# Browser worker processes for search and scraping. (default: 4, range: 1–10)
# Higher values increase throughput but use more CPU and RAM.
# PI_RESEARCH_WORKER_THREADS=4

# Concurrent tasks per worker process. (default: 2, range: 1–10)
# PI_RESEARCH_WORKER_CONCURRENCY=2

# Machine-wide cap on how many research runs may execute AT THE SAME TIME, across
# every process (CLI, agent skill, pi extension, SDK). Runs beyond the cap are not
# rejected — they queue for a slot (see PI_RESEARCH_RUN_ACQUIRE_TIMEOUT_MS below).
# The cap exists because all concurrent runs share one leader-elected browser and
# embedding pool; oversubscribing it degrades every run at once rather than just
# the newest. Raise it only if the machine has CPU/RAM headroom to spare.
# (default: 3, minimum: 1)
# PI_RESEARCH_MAX_CONCURRENT_RUNS=3

# How long a run waits for a free slot before giving up with a "maximum concurrent
# research runs reached" error (CLI exit code 75 = temporary failure, retry later).
# Set 0 to fail immediately instead of queueing. (default: 600000 — 10 minutes)
# PI_RESEARCH_RUN_ACQUIRE_TIMEOUT_MS=600000

# The model research runs on. REQUIRED for the standalone CLI / agent skill (they
# never follow the model selected inside the pi extension). In the pi extension it
# overrides researcher sub-agents and knowledge synthesis, while the coordinator
# and evaluator keep using the session model. Accepts provider/id or a bare id.
# PI_RESEARCH_MODEL=

# Comma-separated list of research tools to DISABLE for every researcher in a run.
# Valid names: search, scrape, security_search, stackexchange, youtube_transcript, grep.
# Merged into the per-run exclude list, so disabled tools are removed from each
# researcher's toolset and named in the coordinator/evaluator prompt. Empty = all enabled.
# PI_RESEARCH_DISABLED_TOOLS=

# Automatically save a markdown report to disk when research completes. (default: false)
# Files go to a "research" or "docs" folder in your project, or your temp folder if at home.
# PI_RESEARCH_REPORT_EXPORT_ENABLED=false

# Pin exported reports to a fixed directory (created if needed), bypassing the
# cwd-relative "smart" resolution above. Useful for the agent skill, which runs
# from the host agent's arbitrary directory. Empty = smart cwd resolution.
# PI_RESEARCH_REPORT_EXPORT_DIR=

# Maximum retries per researcher request. (default: 2, range: 0–5)
# PI_RESEARCH_MAX_RETRIES=2

# Base delay between retries in milliseconds. (default: 2000, range: 100–10000)
# PI_RESEARCH_RETRY_DELAY_MS=2000

# Unique researcher failures that abort the entire run. (default: 2, range: 1–10)
# Raise this if you'd rather let slower, still-in-flight researchers finish before
# giving up, at the cost of a longer wait before the run reports failure.
# PI_RESEARCH_MAX_FAILED_RESEARCHERS=2

# ── Knowledge Store ───────────────────────────────────────────────────────────

# Knowledge store mode: none, project, global. (default: global)
# 'global' shares one knowledge store across every directory; 'project' scopes
# it to the current directory; 'none' disables it. The embedding model only
# downloads/initializes the first time the store is actually written or searched,
# so the global default adds no startup cost until research caches its first page.
# PI_RESEARCH_KNOWLEDGE_STORE_MODE=global

# Embedding model for the knowledge store. (default: onnx-community/granite-embedding-small-english-r2-ONNX)
# PI_RESEARCH_EMBEDDING_MODEL=onnx-community/granite-embedding-small-english-r2-ONNX

# Inference backend for embeddings: auto, webgpu, or cpu. (default: auto)
# auto   = probe WebGPU viability in a disposable child process and fall back to CPU
#          if it cannot run compute here (safe everywhere). Shown as "GPU" in the TUI.
# cpu    = force CPU-only inference (no probe).
# webgpu = force the GPU path with NO probe. Advanced/benchmarking only — can hard-crash
#          (native SIGSEGV) on a software/paravirtual GPU. Not offered in the TUI.
# PI_RESEARCH_EMBEDDING_DEVICE=auto

# Discard the cached WebGPU-viability verdict and probe again on next use (e.g. after
# a GPU driver upgrade). Accepts 1. (default: unset = use cached verdict)
# PI_RESEARCH_WEBGPU_REPROBE=

# How long to keep cached scrapes. (default: 30, range: 1–365 days)
# PI_RESEARCH_CACHE_TTL_DAYS=30

# Max age a cached scrape may be *served* at read time before it's treated as a miss and
# re-scraped fresh. 0 = disabled (serve at any age up to the TTL above); cache age is always
# surfaced to the model regardless. Set e.g. 1 for time-sensitive research. (default: 0, range: 0–3650 days)
# PI_RESEARCH_KNOWLEDGE_STORE_MAX_SERVE_AGE_DAYS=0

# Timeout for embedding model initialization in ms. (default: 300000, range: 10000–600000)
# First-time model download can take several minutes; increase this on slow connections.
# PI_RESEARCH_EMBEDDING_MODEL_INIT_TIMEOUT_MS=300000

# Explicit directory for the knowledge store database. (default: auto-detected)
# PI_RESEARCH_KNOWLEDGE_DIR=

# Directory for transient per-worker browser profiles.
# Default: ~/.cache/pi-research/profiles (disk-backed). Browser profiles are
# deliberately kept OFF the system temp dir: on systems where /tmp is tmpfs
# (RAM-backed), several per-worker profiles consume RAM and — with an OOM killer
# such as earlyoom active — can contribute to the session being killed under
# memory pressure. Point this at a path under the system temp dir to opt back
# into tmpfs/RAM when you have memory headroom and want the extra speed.
# PI_RESEARCH_TMP_DIR=

# Migration strategy when embedding model changes. (default: backup)
# drop = discard old embeddings and start fresh
# backup = rename old data and start fresh (safe, default)
# re-embed = re-compute all embeddings with the new model (slow, but preserves history)
# PI_RESEARCH_MIGRATION_STRATEGY=backup

# ── Timeouts ──────────────────────────────────────────────────────────────────

# Coordinator/evaluator/repair LLM call timeout in ms. (default: 300000 = 5 min, range: 60-600s)
# PI_RESEARCH_LLM_TIMEOUT_MS=300000

# ── LLM thinking & output budgets (advanced; env-only, not in the /research-config TUI) ──

# Chain-of-thought "thinking" level for ALL of the engine's own LLM work — coordinator,
# evaluator, final synthesis, JSON-repair, knowledge extraction, AND the researcher
# sub-agents (deep + quick). Default 'off': these calls emit structured JSON / cited
# reports, so thinking only consumes the output-token budget (and can truncate the answer)
# for at most a marginal quality gain that doesn't justify the cost. Model-agnostic —
# pi clamps the level to whatever the model supports.
# One of: off | minimal | low | medium | high  (default: off)
# PI_RESEARCH_LLM_THINKING_LEVEL=off

# Max output tokens for the coordinator plan + mid-round evaluator decision. Raised from the
# old blanket 4096 so a plan/decision (or a mid-round synthesis) is never truncated. Always
# clamped to the model's real ceiling. (default: 16384, range: 1024–131072)
# PI_RESEARCH_PLANNING_MAX_TOKENS=16384

# Max output tokens for the FINAL synthesized report (the forced-synthesis call). Default
# 32768 so a full cited report is never cut off. Clamped to the model's ceiling.
# (default: 32768, range: 1024–131072)
# PI_RESEARCH_SYNTHESIS_MAX_TOKENS=32768

# Max output tokens per researcher LLM call (deep and quick sub-agents). Without this cap
# the model's full catalog ceiling (~230k for large-context models) is sent as max_tokens,
# which providers that budget-check it up front (e.g. OpenRouter vs remaining credits)
# reject on low balances. Clamped to the model's ceiling. (default: 16384, range: 1024–131072)
# PI_RESEARCH_RESEARCHER_MAX_TOKENS=16384

# Scrape page load timeout. (default: 15000, range: 5000–120000 ms)
# PI_RESEARCH_SCRAPE_TIMEOUT_MS=15000

# Browser search page timeout. (default: 45000, range: 5000–120000 ms)
# PI_RESEARCH_SEARCH_TIMEOUT_MS=45000

# Queue-wait/overhead margin added to each browser operation's own timeout to form its
# task ceiling: a search times out after SEARCH_TIMEOUT_MS + this, a scrape after
# SCRAPE_TIMEOUT_MS + this. (default: 10000, range: 2000–120000)
# PI_RESEARCH_BROWSER_TASK_TIMEOUT_MS=10000

# Health check timeout in milliseconds. (default: 10000, range: 2000–120000)
# PI_RESEARCH_HEALTH_CHECK_TIMEOUT_MS=10000

# ── Advanced (rarely needed) ──────────────────────────────────────────────────

# TUI refresh debounce in milliseconds. (default: 100, range: 0–1000)
# PI_RESEARCH_TUI_REFRESH_DEBOUNCE_MS=100

# Max fraction of context window for initial scrape context. (default: 0.15, range: 0.05–1.0)
# PI_RESEARCH_MAX_SCRAPE_TOKEN_FRACTION_FOR_SCRAPING=0.15

# Estimated tokens per scrape result for planning. (default: 2500, range: 500–10000)
# PI_RESEARCH_AVG_TOKENS_PER_SCRAPE=2500

# Override the state directory. (default: ~/.pi/research/state)
# PI_RESEARCH_STATE_DIR=

# Override the host config-directory name under your home dir (e.g. ~/.pi).
# Advanced — normally auto-detected from the pi host; set only to pin it (e.g.
# in a worker/standalone context that can't resolve the host). (default: .pi)
# PI_RESEARCH_CONFIG_DIR_NAME=.pi

# ── Diagnostics ───────────────────────────────────────────────────────────────

# Enable verbose debug logging. (default: false)
# Writes INFO+DEBUG level output to the log file for diagnosing issues.
# PI_RESEARCH_DEBUG=false

# Mirror logs to the console (stdout/stderr). (default: false)
# Enable this in CI or headless environments to capture log output.
# PI_RESEARCH_CONSOLE_LOG=false

# Override the verbose log file path. (default: OS temp dir)
# Browser worker threads inherit this same path automatically.
# PI_RESEARCH_LOG_PATH=/tmp/pi-research-debug.log

# Optional: send browser worker-thread logs to a SEPARATE file. If set, it is
# respected as-is; if unset, workers log to PI_RESEARCH_LOG_PATH above.
# PI_RESEARCH_LOG_FILE=

# Skip the pre-flight browser/embedding health check and rely on per-task
# timeouts instead. Useful on a slow machine where the warm-up probe is the
# bottleneck. Accepts 1 or true. (default: unset = health check runs)
# PI_RESEARCH_SKIP_HEALTHCHECK=

# Test/diagnostic only. Permit scraping loopback/private/internal addresses,
# bypassing SSRF protection. NEVER enable in production. (default: unset)
# PI_RESEARCH_ALLOW_LOOPBACK_SCRAPE=

# Override the bundled research-skill source directory used by the skill installer
# (auto-resolved from the package by default; rarely needed). (default: unset)
# PI_RESEARCH_SKILL_DIR=

# ── Display / platform (Linux) ────────────────────────────────────────────────

# Linux only. Bare-TTY runs are true-headless and need no X server. Set to true
# to opt into a virtual framebuffer (requires `sudo apt install xvfb`); leave
# unset on a normal desktop or headless server. (default: unset)
# PI_RESEARCH_USE_XVFB=

# ── Install / uninstall lifecycle (read by npm hooks, not at runtime) ─────────
# These are consumed by scripts/setup.cjs (postinstall) and scripts/cleanup.cjs
# (preuninstall); they are not runtime config, but are documented here so the
# file stays the exhaustive env-var reference (see docs/CONFIGURATION.md).

# Set to 1 during `npm install` to skip the camoufox browser download (it is
# fetched lazily on first use instead; standard Playwright convention).
# PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=

# Linux only. Set to true during `npm install` to also install system libraries
# via `npx playwright install-deps` (same as `npm run install:system-deps`).
# PLAYWRIGHT_INSTALL_DEPS=

# Read by scripts/setup.cjs: set to 1/true to make a FAILED camoufox download
# fail the install (exit 1). Default is to warn and exit 0, because the browser
# is fetched lazily on first use and a restrictive network must not break a
# user's install; CI sets this so a broken download cannot pass silently.
# Not consulted from this file — pass it in the environment.
# PI_RESEARCH_STRICT_SETUP=

# Read by scripts/cleanup.cjs: set to 1 to also delete the SHARED camoufox
# browser cache (left in place by default because other installs may reuse it).
# Note this file is not consulted by that script — pass it in the environment:
#   PI_RESEARCH_PURGE_BROWSERS=1 node <package-root>/scripts/cleanup.cjs
# npm >= 7 does not run `preuninstall`, so `npm uninstall` never invokes it.
# PI_RESEARCH_PURGE_BROWSERS=

# ── API Keys ──────────────────────────────────────────────────────────────────

# LLM API key for SDK / CLI mode (not needed when using pi config files)
# PI_RESEARCH_API_KEY=

# LLM provider for SDK / CLI mode (e.g., openai, anthropic, google, openrouter)
# PI_RESEARCH_PROVIDER=

# Stack Exchange API key — raises rate limits for stackexchange tool. (optional)
# Obtain from: https://stackapps.com/apps/oauth
# STACKEXCHANGE_API_KEY=

# GitHub token — raises the security tool's GitHub Advisory rate limit from
# 60/hr to 5000/hr. Any token with default (public) scope works. (optional)
# GITHUB_TOKEN=

# NVD API key — raises the security tool's NVD rate limit ~10x (and tightens
# request spacing from 6s to 0.6s). Request one at:
# https://nvd.nist.gov/developers/request-an-api-key  (optional)
# NVD_API_KEY=

# ── Danger Zone (for testing only — NEVER enable in production) ────────────────

# WARNING: If set to "true", researchers will return fabricated search results
# instead of real web data. Intended for testing only.
# PI_RESEARCH_MOCK_SEARCH=

# WARNING: If set to "true", researchers will return fabricated scrape results
# instead of real page content. Intended for testing only.
# PI_RESEARCH_MOCK_SCRAPE=

# WARNING: If set to "true", bypasses system readiness checks and allows research
# to proceed even when critical services (browser pool, embedding) have failed to
# initialize. Intended for development/testing only.
# PI_RESEARCH_FORCE_READY=
