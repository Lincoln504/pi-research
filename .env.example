# pi-research Configuration
#
# pi-research reads process.env. Use your shell, pi launcher, direnv, or another
# environment loader; the extension does not load this file by itself.

# External SearXNG URL (optional)
# When set, Docker container management is skipped entirely and this URL is used directly.
# Example: SEARXNG_URL=http://localhost:8080
# SEARXNG_URL=

# Per-researcher timeout in milliseconds (default: 360000)
# Valid range: 180000 (3m) to 1800000 (30m)
# PI_RESEARCH_RESEARCHER_TIMEOUT_MS=360000

# Maximum researchers running simultaneously (default: 3, valid range: 1 to 5)
# PI_RESEARCH_MAX_CONCURRENT_RESEARCHERS=3

# Maximum retries per researcher request (default: 3)
# PI_RESEARCH_RESEARCHER_MAX_RETRIES=3

# Maximum delay between retries in milliseconds (default: 5000)
# PI_RESEARCH_RESEARCHER_MAX_RETRY_DELAY_MS=5000

# Default depth for /research command (default: 0, valid range: 0-3)
# PI_RESEARCH_DEFAULT_RESEARCH_DEPTH=0

# Maximum scrape batches per researcher (default: 2, valid range: 0-99, 0=unlimited)
# PI_RESEARCH_MAX_SCRAPE_BATCHES=2

# Number of parallel browser workers for search and scraping (default: 4)
# Valid range: 1 to 16. Higher values increase throughput but use more CPU and RAM.
# PI_RESEARCH_WORKER_THREADS=4

# Number of concurrent tasks per pool worker process (default: 3, range: 1-10)
# PI_RESEARCH_WORKER_CONCURRENCY=3

# Delay before TUI clears after research ends in milliseconds (default: 15000)
# PI_RESEARCH_CONSOLE_RESTORE_DELAY_MS=15000

# Browser health check timeout in milliseconds (default: 30000, valid range: 20000–120000)
# Controls the DDG Lite navigation timeout inside each health check attempt.
# The health check will retry once on failure before declaring the browser unhealthy.
# PI_RESEARCH_HEALTH_CHECK_TIMEOUT_MS=30000

# Scrape page load timeout in milliseconds (default: 15000)
# Time allowed for a single page scrape navigation before giving up.
# PI_RESEARCH_SCRAPE_TIMEOUT_MS=15000

# Global TUI refresh debounce in milliseconds (default: 10)
# PI_RESEARCH_TUI_REFRESH_DEBOUNCE_MS=10

# Knowledge Store Settings
# Whether the local knowledge store is enabled (default: true)
# PI_RESEARCH_KNOWLEDGE_STORE_ENABLED=true

# Embedding model to use for the knowledge store (default: Xenova/all-MiniLM-L6-v2)
# PI_RESEARCH_EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2

# How long to keep cached scrapes in the knowledge store (default: 30 days, valid range: 1-365)
# PI_RESEARCH_KNOWLEDGE_STORE_CACHE_TTL_DAYS=30

# Timeout for embedding model initialization in milliseconds (default: 300000, valid range: 30000-1800000)
# Controls how long to wait for model download/load before timing out.
# PI_RESEARCH_EMBEDDING_MODEL_INIT_TIMEOUT_MS=300000

# Verbose diagnostics (default: disabled)
# Writes JSONL logs to your OS temp directory as pi-research-debug-{hash}.log
# PI_RESEARCH_VERBOSE=1

# Proxy URL (optional)
# Used for routing search requests through a proxy (e.g., for rate limit avoidance)
# Examples:
# PROXY_URL=socks5://127.0.0.1:9050
# PROXY_URL=http://proxy.example.com:8080
# PROXY_URL=http://user:pass@proxy.example.com:8080
# PROXY_URL=

# Brave Search API Key (optional)
# Obtain from: https://brave.com/search/api/
# BRAVE_SEARCH_API_KEY=your_api_key_here

# Stack Exchange API Key (optional)
# Obtain from: https://stackapps.com/apps/oauth
# STACKEXCHANGE_API_KEY=your_api_key_here
