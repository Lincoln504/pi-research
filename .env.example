# pi-research configuration
#
# pi reads process.env. Use your shell, a pi launcher, direnv, or any other
# env loader — this file is not loaded automatically.
#
# Copy relevant lines to src/.env and uncomment them to activate.

# ── External SearXNG instance ─────────────────────────────────────────────────
# When set, pi-research uses this URL directly and skips Docker management.
# SEARXNG_URL=http://localhost:8080

# ── Research ──────────────────────────────────────────────────────────────────

# Per-researcher timeout in milliseconds. (default: 600000, range: 180000–1800000)
# PI_RESEARCH_TIMEOUT_MS=600000

# Maximum researchers running simultaneously. (default: 3, range: 1–5)
# PI_RESEARCH_MAX_RESEARCHERS=3

# Default depth for /research command. (default: 1, range: 1–3)
# 1=normal, 2=deep, 3=ultra. Depth 0 (quick, single-agent) is available per-request.
# PI_RESEARCH_DEFAULT_RESEARCH_DEPTH=1

# Scrape batches per researcher. (default: 2, range: 0–99, 0=unlimited)
# PI_RESEARCH_MAX_SCRAPE_BATCHES=2

# Concurrent URLs fetched per scrape batch. (default: 3, range: 1–20)
# PI_RESEARCH_MAX_CONCURRENT_SCRAPES=3

# Browser worker processes for search and scraping. (default: 4, range: 1–16)
# Higher values increase throughput but use more CPU and RAM.
# PI_RESEARCH_WORKER_THREADS=4

# Concurrent tasks per worker process. (default: 1, range: 1–10)
# PI_RESEARCH_WORKER_CONCURRENCY=1

# Model override for researcher sub-agents. (default: empty = session model)
# Accepts any model ID supported by the pi runtime.
# PI_RESEARCH_MODEL=

# ── Knowledge Store ───────────────────────────────────────────────────────────

# Enable local vector knowledge store. (default: true)
# PI_RESEARCH_KNOWLEDGE_ENABLED=true

# Embedding model for the knowledge store. (default: Xenova/all-MiniLM-L6-v2)
# PI_RESEARCH_EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2

# Inference backend for embeddings: webgpu or cpu. (default: webgpu)
# webgpu uses Dawn/Vulkan/Metal/D3D12 and works on most modern GPUs.
# Set to cpu on headless servers or if you hit GPU driver issues.
# PI_RESEARCH_EMBEDDING_DEVICE=webgpu

# How long to keep cached scrapes. (default: 30, range: 1–365 days)
# PI_RESEARCH_CACHE_TTL_DAYS=30

# Migration strategy when switching embedding models: drop or re-embed. (default: drop)
# drop  — fast, clears all vectors. re-embed — slower, preserves content.
# PI_RESEARCH_MIGRATION_STRATEGY=drop

# ── Diagnostics ───────────────────────────────────────────────────────────────

# Enable verbose JSONL diagnostics. (default: disabled)
# Writes logs to OS temp dir as pi-research-debug-{runId}.log
# PI_RESEARCH_VERBOSE=1

# Override the verbose log file path. (default: OS temp dir)
# PI_RESEARCH_LOG_PATH=/tmp/pi-research-debug.log

# ── API Keys ──────────────────────────────────────────────────────────────────

# Proxy for outgoing search and scrape requests. (optional)
# PROXY_URL=socks5://127.0.0.1:9050

# Brave Search API key — enables the Brave paid search engine. (optional)
# Obtain from: https://brave.com/search/api/
# BRAVE_SEARCH_API_KEY=

# Stack Exchange API key — raises rate limits for stackexchange tool. (optional)
# Obtain from: https://stackapps.com/apps/oauth
# STACKEXCHANGE_API_KEY=

# ── Advanced (rarely needed) ──────────────────────────────────────────────────

# Scrape page load timeout. (default: 15000, range: 5000–120000 ms)
# PI_RESEARCH_SCRAPE_TIMEOUT_MS=15000

# Maximum retries per researcher request. (default: 3, range: 0–10)
# PI_RESEARCH_MAX_RETRIES=3
