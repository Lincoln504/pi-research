{
  "id": "pi-research",
  "name": "Pi Research",
  "description": "Multi-agent web research with stealth browser, security databases, and Stack Exchange integration.",
  "version": "0.1.14",
  "configSchema": {
    "type": "object",
    "properties": {
      "apiKey": {
        "type": "string",
        "description": "LLM API key"
      },
      "provider": {
        "type": "string",
        "description": "LLM provider name"
      },
      "model": {
        "type": "string",
        "description": "Model ID override for researcher sub-agents"
      },
      "timeoutMs": {
        "type": "number",
        "minimum": 180000,
        "maximum": 1800000,
        "default": 300000
      },
      "maxResearchers": {
        "type": "number",
        "minimum": 1,
        "maximum": 5,
        "default": 3
      },
      "defaultDepth": {
        "type": "number",
        "minimum": 0,
        "maximum": 3,
        "default": 1
      },
      "maxScrapeBatches": {
        "type": "number",
        "minimum": 0,
        "maximum": 99,
        "default": 2
      },
      "maxConcurrentScrapes": {
        "type": "number",
        "minimum": 1,
        "maximum": 20,
        "default": 3
      },
      "workerThreads": {
        "type": "number",
        "minimum": 1,
        "maximum": 10,
        "default": 4
      },
      "workerConcurrency": {
        "type": "number",
        "minimum": 1,
        "maximum": 10,
        "default": 2
      },
      "knowledgeEnabled": {
        "type": "boolean",
        "default": true
      },
      "embeddingModel": {
        "type": "string",
        "description": "Embedding model (defaults to user config)"
      },
      "embeddingDevice": {
        "anyOf": [
          {
            "type": "string",
            "const": "webgpu"
          },
          {
            "type": "string",
            "const": "cpu"
          }
        ],
        "default": "webgpu"
      },
      "migrationStrategy": {
        "anyOf": [
          {
            "type": "string",
            "const": "drop"
          },
          {
            "type": "string",
            "const": "re-embed"
          },
          {
            "type": "string",
            "const": "backup"
          }
        ],
        "default": "backup"
      },
      "cacheTtlDays": {
        "type": "number",
        "minimum": 1,
        "maximum": 365,
        "default": 30
      },
      "scrapeTimeoutMs": {
        "type": "number",
        "minimum": 5000,
        "maximum": 120000,
        "default": 15000
      },
      "stackexchangeApiKey": {
        "type": "string",
        "description": "Stack Exchange API key for higher rate limits"
      },
      "reportExportEnabled": {
        "type": "boolean",
        "default": false
      }
    }
  },
  "activation": {
    "onStartup": true
  },
  "setup": {
    "providers": [
      {
        "id": "pi-research",
        "envVars": [
          "STACKEXCHANGE_API_KEY",
          "PI_RESEARCH_MODEL"
        ]
      }
    ]
  },
  "uiHints": {
    "apiKey": {
      "label": "LLM API Key",
      "sensitive": true
    },
    "provider": {
      "label": "LLM Provider"
    },
    "model": {
      "label": "Research Model Override",
      "advanced": true
    },
    "timeoutMs": {
      "label": "Research Timeout (ms)",
      "advanced": true
    },
    "maxResearchers": {
      "label": "Max Concurrent Researchers"
    },
    "defaultDepth": {
      "label": "Default Research Depth",
      "help": "0=quick, 1=normal, 2=deep, 3=ultra"
    },
    "maxScrapeBatches": {
      "label": "Max Scrape Batches",
      "advanced": true
    },
    "maxConcurrentScrapes": {
      "label": "Max Concurrent Scrapes",
      "advanced": true
    },
    "workerThreads": {
      "label": "Browser Workers",
      "advanced": true
    },
    "workerConcurrency": {
      "label": "Worker Concurrency",
      "advanced": true
    },
    "knowledgeEnabled": {
      "label": "Knowledge Store",
      "advanced": true
    },
    "embeddingModel": {
      "label": "Embedding Model",
      "advanced": true
    },
    "embeddingDevice": {
      "label": "Embedding Device",
      "advanced": true
    },
    "cacheTtlDays": {
      "label": "Cache TTL (days)",
      "advanced": true
    },
    "scrapeTimeoutMs": {
      "label": "Scrape Timeout (ms)",
      "advanced": true
    },
    "stackexchangeApiKey": {
      "label": "StackExchange API Key",
      "advanced": true
    },
    "reportExportEnabled": {
      "label": "Export Report",
      "advanced": true
    }
  },
  "contracts": {
    "tools": [
      "research",
      "health",
      "research_knowledge_search"
    ]
  },
  "toolMetadata": {
    "research": {
      "description": "Multi-agent web research with search, scraping, security databases, and Stack Exchange."
    },
    "health": {
      "description": "System health checks across browser pool, knowledge store, and GPU lock."
    },
    "research_knowledge_search": {
      "description": "Satellite tool for the main pi agent. Search the research knowledge database for previously researched information before live research."
    }
  }
}
