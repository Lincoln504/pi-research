{
  "name": "@lincoln504/pi-research",
  "version": "0.1.14",
  "description": "A set of web research tools (search, scrape, and others) and research agent system that uses them safely and efficiently.",
  "type": "module",
  "private": false,
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "src/",
    "!src/.env",
    "!src/.env.local",
    "!src/.env.*.local",
    "!src/knowledge_db/",
    "docs/",
    "scripts/",
    "!scripts/download-models.mjs",
    "LICENSE",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lincoln504/pi-research.git"
  },
  "homepage": "https://github.com/Lincoln504/pi-research#readme",
  "bugs": {
    "url": "https://github.com/Lincoln504/pi-research/issues"
  },
  "keywords": [
    "pi",
    "pi-package",
    "pi-extension",
    "research",
    "agent",
    "web-search",
    "scraping",
    "stealth-browser",
    "camoufox",
    "security",
    "stack-exchange"
  ],
  "author": "Lincolndeen",
  "contributors": [
    "MuratAitov"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "lint": "npx eslint --config config/tooling/eslint.config.js src/",
    "lint:fix": "npx eslint --config config/tooling/eslint.config.js src/ --fix",
    "type-check": "tsc --noEmit",
    "type-check:tests": "tsc --noEmit --project tsconfig.test.json",
    "test": "vitest run --config config/tooling/vitest.config.unit.ts",
    "test:unit": "vitest run --config config/tooling/vitest.config.unit.ts",
    "test:integration": "vitest run --config config/tooling/vitest.config.integration.ts",
    "test:integration:parallel": "vitest run --config config/tooling/vitest.config.integration.parallel.ts",
    "test:integration:serial": "vitest run --config config/tooling/vitest.config.integration.serial.ts",
    "test:integration:fast": "vitest run --config config/tooling/vitest.config.integration.parallel.ts & vitest run --config config/tooling/vitest.config.integration.serial.ts & wait",
    "test:load": "vitest run --config config/tooling/vitest.config.load.ts",
    "test:watch": "vitest --config config/tooling/vitest.config.unit.ts",
    "test:coverage": "vitest run --config config/tooling/vitest.config.unit.ts --coverage",
    "postinstall": "node scripts/setup.cjs",
    "preuninstall": "node scripts/cleanup.cjs",
    "setup": "node scripts/setup.cjs",
    "install:browsers": "node scripts/setup.cjs",
    "install:system-deps": "node scripts/setup.cjs --system-deps",
    "models:download": "node scripts/download-models.mjs",
    "models:download:force": "node scripts/download-models.mjs --force",
    "deps:check": "depcruise --config .dependency-cruiser.cjs --output-type err-long src",
    "deps:generate": "madge --image docs/deps.svg src/index.ts",
    "deps:generate:archi": "depcruise --config .dependency-cruiser.cjs --output-type archi src | dot -T svg > docs/deps-archi.svg",
    "deps:generate:uml": "tsuml2 --glob \"./src/**/*.ts\" -o \"docs/uml.svg\"",
    "deps:report": "depcruise --config .dependency-cruiser.cjs --output-type x-dot-webpage src > docs/deps.html",
    "analyze:cloc": "cloc ./src --md --out docs/CLOC.md",
    "analyze:dependencies": "npm-check",
    "analyze:compatibility": "depngn"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "dependencies": {
    "@huggingface/transformers": "4.2.0",
    "@kreuzberg/html-to-markdown-node": "^2.30.0",
    "@lancedb/lancedb": "0.29.0",
    "@mariozechner/pi-tui": "^0.73.0",
    "apache-arrow": "18.1.0",
    "camoufox-js": "^0.10.2",
    "node-html-markdown": "^2.0.0",
    "pdf-oxide-wasm": "^0.3.37",
    "playwright-core": "^1.59.1",
    "poolifier": "^5.3.2",
    "typebox": "^1.0.0"
  },
  "optionalDependencies": {
    "@kreuzberg/html-to-markdown-node-darwin-arm64": "^2.30.0",
    "@kreuzberg/html-to-markdown-node-darwin-x64": "^2.30.0",
    "@kreuzberg/html-to-markdown-node-linux-arm64-gnu": "^2.30.0",
    "@kreuzberg/html-to-markdown-node-linux-arm64-musl": "^2.30.0",
    "@kreuzberg/html-to-markdown-node-linux-x64-gnu": "^2.30.0",
    "@kreuzberg/html-to-markdown-node-linux-x64-musl": "^2.30.0",
    "@kreuzberg/html-to-markdown-node-win32-x64-msvc": "^2.30.0"
  },
  "peerDependencies": {
    "@mariozechner/pi-ai": "*",
    "@mariozechner/pi-coding-agent": "*"
  },
  "overrides": {
    "lodash.isequal": "npm:fast-deep-equal@^3.1.3",
    "ip-address": "^10.2.0",
    "apache-arrow": "18.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@mariozechner/pi-ai": "^0.73.0",
    "@mariozechner/pi-coding-agent": "^0.73.0",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "@vitest/coverage-v8": "^4.1.2",
    "cloc": "^2.6.0-cloc",
    "dependency-cruiser": "^17.4.2",
    "depngn": "^0.6.0",
    "eslint": "^10.1.0",
    "madge": "^8.0.0",
    "npm-check": "^6.0.1",
    "tsuml2": "^0.17.1",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
