{
  "name": "@lincoln504/pi-research",
  "version": "1.0.0",
  "description": "A set of web research tools (search, scrape, and others) and research agent system that uses them safely and efficiently.",
  "type": "module",
  "private": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "pi-research": "./dist/cli.mjs"
  },
  "exports": {
    ".": "./src/index.ts",
    "./sdk": "./src/sdk.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "src/",
    "dist/cli.mjs",
    "dist/thread-worker.mjs",
    "dist/webgpu-probe.mjs",
    "dist/prompts/",
    "skills/",
    "!skills/pi-research/scripts/run.ts",
    "!src/.env",
    "!src/.env.local",
    "!src/.env.*.local",
    "docs/PI-EXTENSION.md",
    "docs/SDK.md",
    "docs/CONFIGURATION.md",
    "docs/KNOWLEDGE-STORE.md",
    "docs/AGENT-SKILL.md",
    "docs/ARCHITECTURE.md",
    "scripts/setup.cjs",
    "scripts/cleanup.cjs",
    "scripts/build.cjs",
    "scripts/prepare.cjs",
    "LICENSE",
    "docs/THIRD-PARTY-NOTICES.md",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lincoln504/pi-research.git"
  },
  "homepage": "https://github.com/Lincoln504/pi-research#readme",
  "bugs": {
    "url": "https://github.com/Lincoln504/pi-research/issues"
  },
  "keywords": [
    "pi",
    "pi-package",
    "pi-extension",
    "openclaw",
    "agent-skill",
    "research",
    "agent",
    "web-search",
    "scraping",
    "stealth-browser",
    "camoufox",
    "security",
    "stack-exchange"
  ],
  "author": "Lincoln Deen",
  "contributors": [
    "MuratAitov"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "lint": "npx eslint --config config/tooling/eslint.config.js src/",
    "lint:fix": "npx eslint --config config/tooling/eslint.config.js src/ --fix",
    "type-check": "tsc --noEmit",
    "type-check:tests": "tsc --noEmit --project config/tooling/tsconfig.test.json",
    "build:worker": "node scripts/build.cjs worker",
    "test": "npm run test:unit",
    "test:unit": "vitest run --config config/tooling/vitest.config.unit.ts",
    "test:integration": "npm run test:integration:parallel && npm run test:integration:serial",
    "test:integration:parallel": "vitest run --config config/tooling/vitest.config.integration.parallel.ts",
    "test:integration:serial": "vitest run --config config/tooling/vitest.config.integration.serial.ts",
    "test:all": "npm run test:unit && npm run test:integration",
    "test:watch": "vitest --config config/tooling/vitest.config.unit.ts",
    "test:coverage": "vitest run --config config/tooling/vitest.config.unit.ts --coverage",
    "build:cli": "node scripts/build.cjs cli",
    "build:skill": "node scripts/build.cjs skill",
    "build": "node scripts/build.cjs all",
    "prepublishOnly": "node scripts/build.cjs all && node scripts/verify-package.cjs manifest",
    "prepare": "node scripts/prepare.cjs",
    "version": "node -e \"const fs=require('fs');const p=require('./package.json');const sp='./skills/pi-research/SKILL.md';let s=fs.readFileSync(sp,'utf8');s=s.replace(/\\\"version\\\": \\\"[^\\\"]*\\\"/,'\\\"version\\\": \\\"'+p.version+'\\\"');fs.writeFileSync(sp,s);console.log('✔ synced SKILL.md to v'+p.version)\" && git add skills/pi-research/SKILL.md",
    "postinstall": "node scripts/setup.cjs",
    "preuninstall": "node scripts/cleanup.cjs",
    "setup": "node scripts/setup.cjs",
    "install:system-deps": "node scripts/setup.cjs --system-deps",
    "deps:check": "depcruise --config config/tooling/dependency-cruiser.cjs --output-type err-long src",
    "deps:generate": "npx --yes madge --image docs/deps.svg src/index.ts",
    "analyze:dependencies": "ncu",
    "analyze:compatibility": "depngn"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "image": "https://raw.githubusercontent.com/Lincoln504/pi-research/main/docs/media/hero.png"
  },
  "dependencies": {
    "@earendil-works/pi-ai": ">=0.80.2 <1",
    "@earendil-works/pi-coding-agent": ">=0.80.2 <1",
    "@earendil-works/pi-tui": ">=0.80.2 <1",
    "@huggingface/transformers": "4.2.0",
    "@kreuzberg/html-to-markdown-node": "^3.5.5",
    "@lancedb/lancedb": "0.29.0",
    "apache-arrow": "21.1.0",
    "bgutils-js": "^3.2.0",
    "camoufox-js": "^0.10.2",
    "esbuild": "^0.28.1",
    "impit": "0.13.0",
    "jsdom": "^29.1.1",
    "node-html-markdown": "^2.0.0",
    "pdf-oxide-wasm": "^0.3.70",
    "playwright-core": "1.60.0",
    "poolifier": "^5.3.2",
    "typebox": "1.1.38",
    "undici": "^8.6.0",
    "youtubei.js": "^17.2.0"
  },
  "optionalDependencies": {
    "webgpu": "^0.4.0"
  },
  "overrides": {
    "lodash.isequal": "npm:fast-deep-equal@^3.1.3",
    "ip-address": "^10.2.0",
    "apache-arrow": "21.1.0",
    "onnxruntime-web": "1.24.3",
    "node-domexception": "npm:@nolyfill/domexception@^1.0.28",
    "ua-parser-js": "^1.0.41",
    "protobufjs": "7.6.4",
    "vite": "^8.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jsdom": "^28.0.3",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "@vitest/coverage-v8": "^4.1.7",
    "dependency-cruiser": "^17.4.2",
    "depngn": "^0.6.0",
    "eslint": "^10.4.0",
    "npm-check-updates": "^22.2.1",
    "typescript": ">=6.0.3 <6.1.0",
    "vitest": "^4.1.7"
  }
}
