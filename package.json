{
  "name": "@lincoln504/pi-research",
  "version": "1.0.0",
  "description": "A set of web research tools (search, scrape, and others) and research agent system that uses them safely and efficiently.",
  "type": "module",
  "private": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./sdk": "./src/sdk.ts",
    "./openclaw": "./src/openclaw-entry.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "src/",
    "dist/openclaw-entry.js",
    "dist/thread-worker.mjs",
    "dist/prompts/",
    "!src/.env",
    "!src/.env.local",
    "!src/.env.*.local",
    "openclaw.plugin.json",
    "docs/SDK.md",
    "docs/ARCHITECTURE.md",
    "docs/PI-EXTENSION.md",
    "docs/README-banner.jpg",
    "scripts/setup.cjs",
    "scripts/cleanup.cjs",
    "LICENSE",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lincoln504/pi-research.git"
  },
  "homepage": "https://github.com/Lincoln504/pi-research#readme",
  "bugs": {
    "url": "https://github.com/Lincoln504/pi-research/issues"
  },
  "keywords": [
    "pi",
    "pi-package",
    "pi-extension",
    "openclaw",
    "openclaw-plugin",
    "research",
    "agent",
    "web-search",
    "scraping",
    "stealth-browser",
    "camoufox",
    "security",
    "stack-exchange"
  ],
  "author": "Lincolndeen",
  "contributors": [
    "MuratAitov"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "lint": "npx eslint --config config/tooling/eslint.config.js src/",
    "lint:fix": "npx eslint --config config/tooling/eslint.config.js src/ --fix",
    "type-check": "tsc --noEmit",
    "type-check:tests": "tsc --noEmit --project config/tsconfig.test.json",
    "build:worker": "esbuild src/infrastructure/browser/thread-worker.ts --bundle --platform=node --format=esm --packages=external --outfile=src/infrastructure/browser/thread-worker.mjs",
    "build:openclaw:resources": "node -e \"const fs=require('fs');const path=require('path');fs.mkdirSync('dist/prompts',{recursive:true});fs.readdirSync('src/prompts').forEach(f=>{fs.copyFileSync('src/prompts/'+f,'dist/prompts/'+f)});fs.copyFileSync('src/infrastructure/browser/thread-worker.mjs','dist/thread-worker.mjs');console.error('Openclaw resources copied to dist/')\"",
    "test": "npm run test:unit",
    "test:unit": "vitest run --config config/tooling/vitest.config.unit.ts",
    "test:integration": "npm run test:integration:parallel && npm run test:integration:serial",
    "test:integration:parallel": "vitest run --config config/tooling/vitest.config.integration.parallel.ts",
    "test:integration:serial": "vitest run --config config/tooling/vitest.config.integration.serial.ts",
    "test:all": "npm run test:unit && npm run test:integration",
    "test:watch": "vitest --config config/tooling/vitest.config.unit.ts",
    "test:coverage": "vitest run --config config/tooling/vitest.config.unit.ts --coverage",
    "build:openclaw": "esbuild src/openclaw-entry.ts --bundle --platform=node --format=esm --packages=external --external:node:* --outfile=dist/openclaw-entry.js && npm run build:openclaw:resources",
    "prepublishOnly": "npm run build:worker && npm run build:openclaw",
    "prepare": "node scripts/prepare.cjs",
    "version": "node -e \"const p=require('./package.json');const o=require('./openclaw.plugin.json');o.version=p.version;require('fs').writeFileSync('./openclaw.plugin.json',JSON.stringify(o,null,2)+'\\n');console.log('✔ openclaw.plugin.json synced to v'+p.version)\" && git add openclaw.plugin.json",
    "postinstall": "node scripts/setup.cjs",
    "preuninstall": "node scripts/cleanup.cjs",
    "setup": "node scripts/setup.cjs",
    "install:system-deps": "node scripts/setup.cjs --system-deps",
    "deps:check": "depcruise --config config/.dependency-cruiser.cjs --output-type err-long src",
    "deps:generate": "npx --yes madge --image docs/deps.svg src/index.ts",
    "analyze:dependencies": "ncu",
    "analyze:compatibility": "depngn"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "openclaw": {
    "extensions": [
      "./dist/openclaw-entry.js"
    ],
    "compat": {
      "pluginApi": ">=2026.5.17"
    },
    "install": {
      "minHostVersion": ">=2026.5.17"
    }
  },
  "dependencies": {
    "@earendil-works/pi-tui": "0.79.2",
    "@huggingface/transformers": "4.2.0",
    "@kreuzberg/html-to-markdown-node": "^3.5.3",
    "@lancedb/lancedb": "0.29.0",
    "apache-arrow": "21.1.0",
    "camoufox-js": "^0.10.2",
    "node-html-markdown": "^2.0.0",
    "pdf-oxide-wasm": "^0.3.55",
    "playwright-core": "^1.60.0",
    "poolifier": "^5.3.2",
    "typebox": "^1.1.38"
  },
  "optionalDependencies": {
    "@kreuzberg/html-to-markdown-node-darwin-arm64": "^3.5.3",
    "@kreuzberg/html-to-markdown-node-darwin-x64": "^3.5.3",
    "@kreuzberg/html-to-markdown-node-linux-arm64-gnu": "^3.5.3",
    "@kreuzberg/html-to-markdown-node-linux-arm64-musl": "^3.3.2",
    "@kreuzberg/html-to-markdown-node-linux-x64-gnu": "^3.5.3",
    "@kreuzberg/html-to-markdown-node-linux-x64-musl": "^3.3.2",
    "@kreuzberg/html-to-markdown-node-win32-x64-msvc": "^3.5.3",
    "webgpu": "^0.4.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.78.1",
    "@earendil-works/pi-coding-agent": ">=0.78.1"
  },
  "overrides": {
    "lodash.isequal": "npm:fast-deep-equal@^3.1.3",
    "ip-address": "^10.2.0",
    "apache-arrow": "21.1.0",
    "onnxruntime-web": "1.24.3",
    "node-domexception": "npm:@nolyfill/domexception@^1.0.28"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.79.2",
    "@earendil-works/pi-coding-agent": "0.79.2",
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "@vitest/coverage-v8": "^4.1.7",
    "dependency-cruiser": "^17.4.2",
    "depngn": "^0.6.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.4.0",
    "npm-check-updates": "^22.2.1",
    "openclaw": "^2026.6.6",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
