{
  "name": "@lincoln504/pi-research",
  "version": "0.1.14",
  "description": "A set of web research tools (search, scrape, and others) and research agent system that uses them safely and efficiently.",
  "type": "module",
  "private": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./sdk": "./src/sdk.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "src/",
    "!src/.env",
    "!src/.env.local",
    "!src/.env.*.local",
    "docs/OVERVIEW.md",
    "docs/SDK.md",
    "docs/ARCHITECTURE.md",
    "scripts/setup.cjs",
    "scripts/cleanup.cjs",
    "LICENSE",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lincoln504/pi-research.git"
  },
  "homepage": "https://github.com/Lincoln504/pi-research#readme",
  "bugs": {
    "url": "https://github.com/Lincoln504/pi-research/issues"
  },
  "keywords": [
    "pi",
    "pi-package",
    "pi-extension",
    "research",
    "agent",
    "web-search",
    "scraping",
    "stealth-browser",
    "camoufox",
    "security",
    "stack-exchange"
  ],
  "author": "Lincolndeen",
  "contributors": [
    "MuratAitov"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "lint": "npx eslint --config config/tooling/eslint.config.js src/",
    "lint:fix": "npx eslint --config config/tooling/eslint.config.js src/ --fix",
    "type-check": "tsc --noEmit",
    "type-check:tests": "tsc --noEmit --project config/tsconfig.test.json",
    "build:worker": "esbuild src/infrastructure/browser/thread-worker.ts --bundle --platform=node --format=esm --packages=external --outfile=src/infrastructure/browser/thread-worker.mjs",
    "test": "npm run test:unit",
    "test:unit": "vitest run --config config/tooling/vitest.config.unit.ts",
    "test:integration": "npm run test:integration:parallel && npm run test:integration:serial",
    "test:integration:parallel": "vitest run --config config/tooling/vitest.config.integration.parallel.ts",
    "test:integration:serial": "vitest run --config config/tooling/vitest.config.integration.serial.ts",
    "test:load": "vitest run --config config/tooling/vitest.config.load.ts",
    "test:full": "npm run test:unit && npm run test:integration && npm run test:load",
    "test:watch": "vitest --config config/tooling/vitest.config.unit.ts",
    "test:coverage": "vitest run --config config/tooling/vitest.config.unit.ts --coverage",
    "prepublishOnly": "npm run build:worker",
    "postinstall": "node scripts/setup.cjs",
    "preuninstall": "node scripts/cleanup.cjs",
    "setup": "node scripts/setup.cjs",
    "install:browsers": "node scripts/setup.cjs",
    "install:system-deps": "node scripts/setup.cjs --system-deps",
    "models:download": "node scripts/download-models.mjs",
    "models:download:force": "node scripts/download-models.mjs --force",
    "deps:check": "depcruise --config config/.dependency-cruiser.cjs --output-type err-long src",
    "deps:generate": "madge --image docs/deps.svg src/index.ts",
    "deps:report": "depcruise --config config/.dependency-cruiser.cjs --output-type x-dot-webpage src > docs/deps.html",
    "analyze:dependencies": "ncu",
    "analyze:compatibility": "depngn"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "dependencies": {
    "@earendil-works/pi-tui": "^0.78.1",
    "@huggingface/transformers": "4.2.0",
    "@kreuzberg/html-to-markdown-node": "^3.5.3",
    "@lancedb/lancedb": "0.29.0",
    "apache-arrow": "21.1.0",
    "camoufox-js": "^0.10.2",
    "node-html-markdown": "^2.0.0",
    "pdf-oxide-wasm": "^0.3.55",
    "playwright-core": "^1.60.0",
    "poolifier": "^5.3.2",
    "typebox": "^1.1.38"
  },
  "optionalDependencies": {
    "@kreuzberg/html-to-markdown-node-darwin-arm64": "^3.5.3",
    "@kreuzberg/html-to-markdown-node-darwin-x64": "^3.5.3",
    "@kreuzberg/html-to-markdown-node-linux-arm64-gnu": "^3.5.3",
    "@kreuzberg/html-to-markdown-node-linux-arm64-musl": "^3.3.2",
    "@kreuzberg/html-to-markdown-node-linux-x64-gnu": "^3.5.3",
    "@kreuzberg/html-to-markdown-node-linux-x64-musl": "^3.3.2",
    "@kreuzberg/html-to-markdown-node-win32-x64-msvc": "^3.5.3",
    "webgpu": "^0.4.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.78.1",
    "@earendil-works/pi-coding-agent": ">=0.78.1"
  },
  "overrides": {
    "lodash.isequal": "npm:fast-deep-equal@^3.1.3",
    "ip-address": "^10.2.0",
    "apache-arrow": "21.1.0",
    "onnxruntime-web": "1.24.3"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.78.1",
    "@earendil-works/pi-coding-agent": "^0.78.1",
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "@vitest/coverage-v8": "^4.1.7",
    "dependency-cruiser": "^17.4.2",
    "depngn": "^0.6.0",
    "esbuild": "^0.28.0",
    "eslint": "^10.4.0",
    "madge": "^8.0.0",
    "npm-check-updates": "^22.2.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
